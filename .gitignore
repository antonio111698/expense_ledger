# Build output — generated from source, never committed.
# These are rebuilt in seconds; committing them creates noise in every diff.
target/
*.class

# IDE settings — personal to my machine, not part of the project.
.idea/
*.iml
.vscode/


# Secrets — files holding passwords, keys or connection strings.
# Git history is permanent, so a secret committed once is exposed forever.
.env

application-local.properties

